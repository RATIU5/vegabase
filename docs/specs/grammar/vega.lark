first_block: _NL* (statement (_NL+ statement)*)? _NL*

?statement: use | template_line | declaration
use: _USE NAME
template_line: _TEMPLATE TYPE
declaration: TYPE "::" (component | content | type admin?)
           | LOCALE_NAME "::" locale

component: _COMPONENT "{" _NL* (_cpart (_NL+ _cpart)*)? _NL* "}"
content: _CONTENT "{" _NL* (_cpart (_NL+ _cpart)*)? _NL* "}"
_cpart: admin | fields | props
fields: _FIELDS "{" _NL* (field (_sep field)*)? _sep? "}"
props: _PROPS "{" _NL* (field (_sep field)*)? _sep? "}"
locale: _LOCALE record

field: NAME ":" SLOT? type OPTIONAL? default? admin?
default: "=" expr
admin: "@" record

type: type_atom ("|" type_atom)*
type_atom: (type_name | STRING) limits?
type_name: (NAME ".")? TYPE
limits: record

record: "{" _NL* (entry (_sep entry)*)? _sep? "}"
entry: OF "=" type | NAME "=" expr
_sep: ("," | _NL)+

inline: (tag | expr)?
?tag: if_tag | elif_tag | else_tag | end_if | for_tag | end_for | slot_tag | render_tag
if_tag: _IF expr
elif_tag: _ELIF expr
else_tag: _ELSE
end_if: "/if"
for_tag: _FOR NAME ("," NAME)? _IN expr
end_for: "/for"
slot_tag: SLOT NAME record?
render_tag: _RENDER type_name record

?expr: pipe | and_expr | or_expr | _simple
and_expr: _simple (_AND _simple)+
or_expr: _simple (_OR _simple)+
_simple: not_expr | compare | coalesce | sum
pipe: operand ("|" pipe_target)+
pipe_target: fn_name ("(" args? ")")?
not_expr: _NOT operand
compare: sum COMPARE sum
?sum: product (ADD_OP product)*
?product: unary (MUL_OP unary)*
?unary: NEG unary | operand
coalesce: operand ("??" operand)+

?operand: path | call | literal | host_value | list | component_value | record | "(" _NL* expr _NL* ")"
path: NAME ("." MEMBER)*
call: fn_name "(" args? ")"
fn_name: NAME ("." MEMBER)?
args: _NL* expr (_NL* "," _NL* expr)* _NL*
list: "[" _NL* (expr (_sep expr)*)? _sep? "]"
component_value: type_name record
host_value: HOST_VALUE
literal: STRING | DECIMAL | INT | TRUE | FALSE | NULL

_USE: /use\b/
_TEMPLATE: /template\b/
_COMPONENT: /component\b/
_CONTENT: /content\b/
_FIELDS: /fields\b/
_PROPS: /props\b/
_LOCALE: /locale\b/
_RENDER: /render\b/
_IF: /if\b/
_ELIF: /elif\b/
_ELSE: /else\b/
_FOR: /for\b/
_IN: /in\b/
_NOT: /not\b/
_AND: /and\b/
_OR: /or\b/
SLOT: /slot\b/
OF: /of\b/
OPTIONAL: "?"
COMPARE: "==" | "!=" | "<=" | ">=" | "<" | ">"
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
NEG: "-"
TRUE: /true\b/
FALSE: /false\b/
NULL: /null\b/
HOST_VALUE: /\$[a-z][A-Za-z0-9_]*(\.[a-z][A-Za-z0-9_]*)*/
TYPE: /[A-Z][A-Za-z0-9]*/
NAME: /(?!(of|use|template|component|content|fields|props|locale|slot|render|if|elif|else|for|in|not|and|or|true|false|null)\b)[a-z][A-Za-z0-9_]*/
MEMBER: /[a-z][A-Za-z0-9_]*/
STRING: /"([^"\\\n]|\\["\\])*"/
LOCALE_NAME: /[a-z]{2,3}(_[A-Za-z0-9]{2,8})*/
DECIMAL: /[0-9]+\.[0-9]+/
INT: /[0-9]+/
_NL: /\r?\n/

%ignore /[ \t]+/
%ignore /#[^\n]*/
