{{
  use std

  Hero :: component {
    @{
      label = t("hero.label")
      hint = t("hero.hint")
    }

    fields {
      heading:    Headline = "Welcome"
      subheading: Text { max = 160 }? @{ label = "Subheading" }
      tone:       Tone = "light"
      # overlay is offered only for the dark tone
      overlay:    Int { min = 0, max = 90 } = 40 @{ show = tone == "dark" }
      image:      std.Image
      link:       std.Url? @{ label = "Button link" }
    }
  }

  template Hero
}}
<section class="hero hero-{{tone}}" data-overlay="{{overlay}}">
  <img src="{{image | std.imageUrl(1600)}}" alt="{{image.alt}}">
  <h1>{{heading}}</h1>
  {{if subheading != null}}
    <p>{{subheading}}</p>
  {{/if}}
  {{if link != null}}
    <a class="button" href="{{link}}">{{t("hero.button")}}</a>
  {{/if}}
</section>
