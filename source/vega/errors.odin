package vega

Error :: struct {
	span: Span,
	code: Error_Code,
	hint: string,
}

Error_Code :: enum u8 {
	Block_Never_Closed,
	String_Never_Closed,
	Unexpected_Character,
	Expected_Statement,
	Expected_Newline,
	Expected_Name,
	Expected_Type_Name,
	Expected_Colon_Colon,
	Expected_Declaration,
	Expected_Locale,
	Expected_Open_Brace,
	Expected_Body_Part,
	Expected_Part_End,
	Expected_Colon,
	Expected_Separator,
	Expected_Equal,
	Expected_Entry_Key,
	Expected_Type,
	Expected_Expression,
	Duplicate_Admin,
	Duplicate_Fields,
	Duplicate_Props,
	Bad_Locale_Name,
	Unclosed_Bracket,
	Nested_Too_Deeply,
	And_Or_Mixed,
	Compare_Chained,
	Pipe_Needs_Operand,
	Coalesce_Needs_Operand,
	Operator_Needs_Parens,
	Unexpected_Dot,
	Expected_Close_Paren,
	Expected_Call_End,
	Expected_List_End,
	Expected_Block_End,
	Expected_In,
	Elif_Outside_If,
	Else_Outside_If,
	End_If_Closes_Nothing,
	End_For_Closes_Nothing,
	If_Never_Closed,
	For_Never_Closed,
	Statement_Outside_First_Block,
	Unknown_Escape,
	Invalid_Utf8,
	Close_Brace_Without_Open,
}

@(rodata)
ERROR_MESSAGES := [Error_Code]string {
	.Block_Never_Closed            = "{{ is never closed",
	.String_Never_Closed           = "string is never closed",
	.Unexpected_Character          = "unexpected character",
	.Expected_Statement            = "expected use, template or a declaration",
	.Expected_Newline              = "expected a new line after the statement",
	.Expected_Name                 = "expected a name",
	.Expected_Type_Name            = "expected a type name",
	.Expected_Colon_Colon          = "expected ::",
	.Expected_Declaration          = "expected component, content or a type after ::",
	.Expected_Locale               = "expected locale after ::",
	.Expected_Open_Brace           = "expected {",
	.Expected_Body_Part            = "expected @, fields or props",
	.Expected_Part_End             = "expected a new line or }",
	.Expected_Colon                = "expected :",
	.Expected_Separator            = "expected , or a new line or }",
	.Expected_Equal                = "expected =",
	.Expected_Entry_Key            = "expected a name or of",
	.Expected_Type                 = "expected a type",
	.Expected_Expression           = "expected an expression",
	.Duplicate_Admin               = "a declaration can have only one @ block",
	.Duplicate_Fields              = "a declaration can have only one fields group",
	.Duplicate_Props               = "a declaration can have only one props group",
	.Bad_Locale_Name               = "locale name must be a language code such as en or pt_BR",
	.Unclosed_Bracket              = "bracket is never closed",
	.Nested_Too_Deeply             = "nesting is too deep",
	.And_Or_Mixed                  = "`and` and `or` cannot mix; use parentheses",
	.Compare_Chained               = "comparisons cannot be chained; use parentheses",
	.Pipe_Needs_Operand            = "the input of | must be one value; use parentheses",
	.Coalesce_Needs_Operand        = "the left side of ?? must be one value; use parentheses",
	.Operator_Needs_Parens         = "use parentheses to combine this operator",
	.Unexpected_Dot                = "unexpected . after a value",
	.Expected_Close_Paren          = "expected )",
	.Expected_Call_End             = "expected , or )",
	.Expected_List_End             = "expected , or a new line or ]",
	.Expected_Block_End            = "expected }} to end the block",
	.Expected_In                   = "expected in",
	.Elif_Outside_If               = "{{elif}} is not inside an open {{if}}",
	.Else_Outside_If               = "{{else}} is not inside an open {{if}}",
	.End_If_Closes_Nothing         = "{{/if}} closes nothing",
	.End_For_Closes_Nothing        = "{{/for}} closes nothing",
	.If_Never_Closed               = "{{if}} is never closed",
	.For_Never_Closed              = "{{for}} is never closed",
	.Statement_Outside_First_Block = "use, template and declarations belong in the first block",
	.Unknown_Escape                = "unknown escape in string",
	.Invalid_Utf8                  = "string is not valid UTF-8",
	.Close_Brace_Without_Open      = "} with no {",
}

fail :: proc(errors: ^[dynamic]Error, start, end: int, code: Error_Code) -> bool {
	append(errors, Error{span = {u32(start), u32(end)}, code = code})
	return false
}
